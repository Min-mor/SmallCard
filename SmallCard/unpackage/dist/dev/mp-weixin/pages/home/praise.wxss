
/* 页面容器 */
.praise-page.data-v-7a94c73d {
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 头部样式 */
.header.data-v-7a94c73d {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background-color: #fff;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}
.back-btn.data-v-7a94c73d {
  width: 40rpx;
  height: 40rpx;
}
.title.data-v-7a94c73d {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}
.placeholder.data-v-7a94c73d {
  width: 50rpx;
}

/* 夸夸列表样式 */
.praise-list.data-v-7a94c73d {
  padding: 100rpx 30rpx 30rpx 30rpx;
}

/* 夸夸卡片样式 */
.praise-card.data-v-7a94c73d {
  background-color: #fff;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

/* 卡片头部 */
.card-header.data-v-7a94c73d {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

/* 用户头像 */
.user-avatar.data-v-7a94c73d {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

/* 用户信息 */
.user-info.data-v-7a94c73d {
  flex: 1;
}
.user-name.data-v-7a94c73d {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: block;
}
.user-level.data-v-7a94c73d {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
}

/* 夸夸图标 */
.praise-icon.data-v-7a94c73d {
  width: 48rpx;
  height: 48rpx;
}

/* 卡片内容 */
.card-content.data-v-7a94c73d {
  padding-left: 100rpx;
}
.content-text.data-v-7a94c73d {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

/* 夸夸图片样式 */
.praise-image.data-v-7a94c73d {
  width: 100%;
  height: 300rpx;
  border-radius: 12rpx;
  margin-top: 20rpx;
  background-color: #f5f5f5;
}
