
.contact-page.data-v-6bf5d4b5 {
  padding: 30rpx;
  background-color: #fff;
  min-height: 100vh;
  box-sizing: border-box;
  padding-top: 80rpx; /* 留出头部空间 */
}
.header.data-v-6bf5d4b5 {
  display: flex;
  align-items: center;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 80rpx;
  padding: 0 30rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #eee;
  z-index: 10;
}
.back-btn.data-v-6bf5d4b5 {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 36rpx;
  background: transparent;
  color: #333;
  padding: 0;
}
.page-title.data-v-6bf5d4b5 {
  flex: 1;
  text-align: center;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}
.contact-form.data-v-6bf5d4b5 {
  margin-top: 40rpx;
}
.form-item.data-v-6bf5d4b5 {
  margin-bottom: 40rpx;
}
.label.data-v-6bf5d4b5 {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
}
.input.data-v-6bf5d4b5 {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #eee;
  border-radius: 10rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

/* 社交链接样式 */
.social-section.data-v-6bf5d4b5 {
  margin: 50rpx 0 40rpx;
}
.section-label.data-v-6bf5d4b5 {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
  font-weight: 500;
}
.social-item.data-v-6bf5d4b5 {
  display: flex;
  align-items: center;
  margin-bottom: 25rpx;
}
.social-icon.data-v-6bf5d4b5 {
  width: 50rpx;
  height: 50rpx;
  margin-right: 20rpx;
}
.social-input.data-v-6bf5d4b5 {
  flex: 1;
  height: 76rpx;
  border: 1rpx solid #eee;
  border-radius: 10rpx;
  padding: 0 20rpx;
  margin-right: 20rpx;
  box-sizing: border-box;
  font-size: 26rpx;
}
.close-text.data-v-6bf5d4b5 {
  font-size: 30rpx;
  color: #999;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}
.close-text.data-v-6bf5d4b5:active {
  background-color: #f5f5f5;
}
.qr-upload.data-v-6bf5d4b5 {
  width: 200rpx;
  height: 200rpx;
  border: 1rpx dashed #ddd;
  border-radius: 10rpx;
  position: relative;
  overflow: hidden;
}
.qr-image.data-v-6bf5d4b5 {
  width: 100%;
  height: 100%;
}
.upload-text.data-v-6bf5d4b5 {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 24rpx;
  color: #999;
  text-align: center;
  width: 100%;
}
.save-btn.data-v-6bf5d4b5 {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #2699fb;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  margin-top: 60rpx;
}
button.data-v-6bf5d4b5::after {
  border: none;
}
