
.card-detail.data-v-ca7809bb {
  background-color: #fff;
  min-height: 100vh;
  padding-bottom: 100rpx; /* 为底部操作按钮留空间 */
}
.header.data-v-ca7809bb {
  padding: 30rpx;
}
.back-btn.data-v-ca7809bb {
  width: 40rpx;
  height: 40rpx;
}
.card-container.data-v-ca7809bb {
  padding: 0 30rpx;
}

/* 头像区域 */
.avatar-section.data-v-ca7809bb {
  display: flex;
  justify-content: center;
  margin-bottom: 30rpx;
}
.user-avatar.data-v-ca7809bb {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

/* 用户信息 */
.user-info.data-v-ca7809bb {
  text-align: center;
  margin-bottom: 30rpx;
}
.user-name.data-v-ca7809bb {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}
.user-tag.data-v-ca7809bb {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 10rpx;
}

/* 标签信息 */
.tags-section.data-v-ca7809bb {
  margin: 20rpx 0;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
  padding: 0 20rpx;
}
.tag-text.data-v-ca7809bb {
  padding: 8rpx 20rpx;
  background-color: #f0f0f0;
  border-radius: 50rpx;
  font-size: 26rpx;
  color: #666;
  display: inline-block;
  margin-bottom: 10rpx;
}

/* 社交信息 */
.social-info.data-v-ca7809bb {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
  gap: 20rpx;
  padding: 0 20rpx;
}
.social-item.data-v-ca7809bb {
  font-size: 26rpx;
  color: #666;
}
.social-avatar.data-v-ca7809bb,
.add-avatar.data-v-ca7809bb {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin-left: 10rpx;
}
.add-avatar.data-v-ca7809bb {
  background-color: #f0f0f0;
}

/* 加好友按钮 */
.action-section.data-v-ca7809bb {
  margin-bottom: 30rpx;
  display: flex;
  justify-content: center;
  padding: 0 20rpx;
}
.add-friend-btn.data-v-ca7809bb {
  width: 100%;
  height: 80rpx;
  background-color: #fff;
  color: #333;
  border: 2rpx solid #ddd;
  border-radius: 40rpx;
  font-size: 28rpx;
}
.add-friend-btn.data-v-ca7809bb::after {
  border: none;
}

/* 内容展示区域 */
.content-section.data-v-ca7809bb {
  margin-bottom: 20rpx;
  padding: 0 20rpx;
}
.content-card.data-v-ca7809bb {
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}
.content-image.data-v-ca7809bb {
  width: 100%;
  height: 200rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}
.content-text.data-v-ca7809bb {
  font-size: 28rpx;
  color: #333;
  display: block;
  text-align: center;
}

/* 夸夸内容展示区域 */
.praise-messages-section.data-v-ca7809bb {
  margin: 30rpx 20rpx;
  padding: 20rpx;
  background-color: #f9f9f9;
  border-radius: 12rpx;
  min-height: 100rpx; /* 确保有足够高度显示内容 */
}
.section-title.data-v-ca7809bb {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}
.praise-message.data-v-ca7809bb {
  padding: 16rpx 0;
  display: block;
  width: 100%;
  word-break: break-all; /* 确保长文本能正确换行 */
}
.praise-message-text.data-v-ca7809bb {
  font-size: 28rpx;
  color: #666;
  display: inline-block;
  width: 100%;
}

/* 夸夸消息中的图片样式 */
.praise-message-image.data-v-ca7809bb {
  width: 100%;
  height: 300rpx;
  border-radius: 12rpx;
  margin-top: 16rpx;
  object-fit: cover;
}

/* 底部操作按钮 */
.bottom-actions.data-v-ca7809bb {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background-color: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 40rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
}

/* 左下角夸夸TA按钮 */
.praise-button.data-v-ca7809bb {
  display: flex;
  align-items: center;
  background-color: #1E90FF;
  padding: 16rpx 32rpx;
  border-radius: 50rpx;
}
.praise-icon.data-v-ca7809bb {
  width: 56rpx;
  height: 56rpx;
  margin-right: 12rpx;
}
.praise-text.data-v-ca7809bb {
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
}

/* 右下角操作按钮组 */
.action-buttons.data-v-ca7809bb {
  display: flex;
  gap: 40rpx;
}
.action-btn.data-v-ca7809bb {
  width: 90rpx;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f5f5;
  border-radius: 50%;
}
.action-btn .action-icon.data-v-ca7809bb {
    width: 60rpx;
    height: 60rpx;
    margin-bottom: 0;
}
  
  /* 分享弹窗样式 */
.share-modal.data-v-ca7809bb {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    display: flex;
    justify-content: center;
    align-items: flex-end;
    z-index: 999;
}
.share-content.data-v-ca7809bb {
    background-color: #fff;
    width: 100%;
    border-top-left-radius: 30rpx;
    border-top-right-radius: 30rpx;
    padding: 30rpx;
}
.share-title.data-v-ca7809bb {
    font-size: 32rpx;
    text-align: center;
    margin-bottom: 40rpx;
    color: #333;
}
.share-options.data-v-ca7809bb {
    display: flex;
    justify-content: space-around;
    margin-bottom: 40rpx;
}
.share-option.data-v-ca7809bb {
    display: flex;
    flex-direction: column;
    align-items: center;
}
.share-icon.data-v-ca7809bb {
    width: 100rpx;
    height: 100rpx;
    margin-bottom: 20rpx;
}
.share-text.data-v-ca7809bb {
    font-size: 28rpx;
    color: #666;
}
.share-cancel.data-v-ca7809bb {
    text-align: center;
    font-size: 32rpx;
    padding: 24rpx 0;
    background-color: #f5f5f5;
    border-radius: 16rpx;
    color: #333;
}
