
.friend-detail-page.data-v-c7ff6d1e {
    flex: 1;
    background-color: #f5f5f5;
    min-height: 100vh;
}

  /* 顶部导航栏 */
.header.data-v-c7ff6d1e {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20rpx 30rpx;
    background-color: #fff;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}
.back-btn.data-v-c7ff6d1e {
    width: 60rpx;
    height: 60rpx;
    display: flex;
    align-items: center;
    justify-content: center;
}
.back-icon.data-v-c7ff6d1e {
    width: 40rpx;
    height: 40rpx;
}
.title.data-v-c7ff6d1e {
    font-size: 36rpx;
    font-weight: 600;
    color: #333;
}
.more-btn.data-v-c7ff6d1e {
    width: 60rpx;
    height: 60rpx;
    display: flex;
    align-items: center;
    justify-content: center;
}
.more-icon.data-v-c7ff6d1e {
    font-size: 40rpx;
    color: #666;
}

  /* 主要内容区域 */
.content.data-v-c7ff6d1e {
    padding-top: 100rpx;
    padding-bottom: 160rpx;
}

  /* 区块样式 */
.section.data-v-c7ff6d1e {
    background-color: #fff;
    margin-bottom: 20rpx;
    padding: 30rpx;
}
.section-header.data-v-c7ff6d1e {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30rpx;
}
.section-title.data-v-c7ff6d1e {
    font-size: 32rpx;
    font-weight: 600;
    color: #333;
}
.section-action.data-v-c7ff6d1e {
    display: flex;
    align-items: center;
}
.count.data-v-c7ff6d1e {
    font-size: 28rpx;
    color: #999;
    margin-right: 10rpx;
}
.arrow-icon.data-v-c7ff6d1e {
    width: 24rpx;
    height: 24rpx;
}

  /* 好友卡片样式 */
.friend-card.data-v-c7ff6d1e {
    display: flex;
    align-items: center;
    margin-bottom: 30rpx;
}
.friend-card.data-v-c7ff6d1e:last-child {
    margin-bottom: 0;
}
.friend-avatar.data-v-c7ff6d1e {
    width: 120rpx;
    height: 120rpx;
    border-radius: 50%;
    margin-right: 30rpx;
}
.friend-info.data-v-c7ff6d1e {
    flex: 1;
}
.friend-name.data-v-c7ff6d1e {
    font-size: 32rpx;
    font-weight: 600;
    color: #333;
    margin-bottom: 10rpx;
}
.friend-signature.data-v-c7ff6d1e {
    font-size: 28rpx;
    color: #999;
}
.follow-btn.data-v-c7ff6d1e {
    padding: 15rpx 40rpx;
    border-radius: 30rpx;
    font-size: 28rpx;
    border: 2rpx solid #07c160;
    color: #07c160;
}
.mutual-follow.data-v-c7ff6d1e {
    background-color: #f0f9ff;
    border-color: #e0f2fe;
    color: #07c160;
}

  /* 底部按钮 */
.bottom-section.data-v-c7ff6d1e {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 30rpx;
    background-color: #fff;
    box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}
.add-friend-btn.data-v-c7ff6d1e {
    width: 100%;
    height: 90rpx;
    background-color: #07c160;
    color: #fff;
    border-radius: 45rpx;
    font-size: 32rpx;
    display: flex;
    align-items: center;
    justify-content: center;
}
