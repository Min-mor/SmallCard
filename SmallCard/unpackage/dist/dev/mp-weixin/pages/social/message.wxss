
.message-page.data-v-df03d2f4 {
  height: 100vh;
  background-color: #f5f5f5;
  display: flex;
  flex-direction: column;
}

/* 顶部导航栏 */
.message-header.data-v-df03d2f4 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 30rpx;
  background-color: #fff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  position: -webkit-sticky;
  position: sticky;
  top: 0;
  z-index: 100;
}
.back-button.data-v-df03d2f4 {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.back-image.data-v-df03d2f4 {
  width: 44rpx;
  height: 44rpx;
}
.header-title.data-v-df03d2f4 {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}
.placeholder.data-v-df03d2f4 {
  width: 44rpx;
}

/* 消息列表 */
.message-list.data-v-df03d2f4 {
  flex: 1;
  padding: 20rpx;
  overflow-y: auto;
}

/* 消息项 */
.message-item.data-v-df03d2f4 {
  display: flex;
  padding: 20rpx;
  background-color: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.2s;
}
.message-item.data-v-df03d2f4:active {
  transform: scale(0.98);
}
.message-avatar.data-v-df03d2f4 {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}
.message-content.data-v-df03d2f4 {
  flex: 1;
  min-height: 96rpx;
}
.message-info.data-v-df03d2f4 {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}
.message-name.data-v-df03d2f4 {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-right: 10rpx;
}
.message-action.data-v-df03d2f4 {
  font-size: 28rpx;
  color: #666;
}
.message-action.liked.data-v-df03d2f4 {
  color: #ff4444;
}
.message-action.commented.data-v-df03d2f4 {
  color: #07c160;
}
.message-post-content.data-v-df03d2f4 {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.message-comment-content.data-v-df03d2f4 {
  font-size: 28rpx;
  color: #666;
  background-color: #f5f5f5;
  padding: 10rpx 20rpx;
  border-radius: 16rpx;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.message-time.data-v-df03d2f4 {
  font-size: 24rpx;
  color: #bbb;
}

/* 空状态 */
.empty-state.data-v-df03d2f4 {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}
.empty-icon.data-v-df03d2f4 {
  width: 200rpx;
  height: 200rpx;
  opacity: 0.5;
  margin-bottom: 30rpx;
}
.empty-text.data-v-df03d2f4 {
  font-size: 28rpx;
  color: #999;
}
