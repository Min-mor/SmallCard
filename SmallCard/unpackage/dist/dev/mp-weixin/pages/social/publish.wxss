
/* 你的样式代码保持不变 */
.publish-page.data-v-55c4bc3e {
  padding-bottom: 120rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}
.publish-nav.data-v-55c4bc3e {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 100rpx;
  padding: 0 30rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #eee;
}
.back-btn.data-v-55c4bc3e { font-size: 30rpx; color: #333;
}
.nav-title.data-v-55c4bc3e { font-size: 34rpx; font-weight: 600; color: #333;
}
.empty.data-v-55c4bc3e { width: 30rpx;
}
.publish-content.data-v-55c4bc3e {
  padding: 30rpx;
  background-color: #fff;
  margin: 20rpx;
  border-radius: 20rpx;
}
.user-info.data-v-55c4bc3e {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.user-avatar.data-v-55c4bc3e {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 2rpx solid #f0f0f0;
  object-fit: cover;
}
.user-name.data-v-55c4bc3e { font-size: 30rpx; color: #333; font-weight: 500;
}
.content-input.data-v-55c4bc3e {
  width: 100%;
  min-height: 200rpx;
  font-size: 30rpx;
  line-height: 1.6;
  color: #333;
  padding: 10rpx;
  border: 1rpx solid #f0f0f0;
  border-radius: 10rpx;
  resize: none;
}
.image-upload.data-v-55c4bc3e { margin-top: 30rpx;
}
.upload-title.data-v-55c4bc3e { font-size: 28rpx; color: #666; margin-bottom: 15rpx;
}
.image-list.data-v-55c4bc3e { display: flex; flex-wrap: wrap; gap: 15rpx;
}
.image-item.data-v-55c4bc3e {
  width: 160rpx;
  height: 160rpx;
  position: relative;
  border-radius: 10rpx;
  overflow: hidden;
  background-color: #f5f5f5;
}
.selected-img.data-v-55c4bc3e, .add-icon.data-v-55c4bc3e { width: 100%; height: 100%;
}
.add-btn.data-v-55c4bc3e {
  border: 1rpx dashed #ccc;
  display: flex;
  justify-content: center;
  align-items: center;
}
.delete-img.data-v-55c4bc3e {
  position: absolute;
  top: -15rpx;
  right: -15rpx;
  width: 30rpx;
  height: 30rpx;
  background-color: rgba(0, 0, 0, 0.6);
  color: white;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 24rpx;
  z-index: 10;
}
.word-count.data-v-55c4bc3e {
  font-size: 26rpx;
  color: #999;
  text-align: right;
  margin-top: 15rpx;
}
.publish-btn-container.data-v-55c4bc3e {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 20rpx 30rpx;
  background-color: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}
.submit-btn.data-v-55c4bc3e {
  width: 100%;
  height: 80rpx;
  background-color: #007aff;
  color: white;
  border-radius: 40rpx;
  font-size: 32rpx;
  border: none;
}
.submit-btn[disabled].data-v-55c4bc3e { background-color: #c0c4cc;
}
