
/* 页面基础样式 */
.home-page.data-v-1cf27b2a {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 120rpx; /* 预留底部导航空间 */
}

/* 搜索栏 */
.search-bar.data-v-1cf27b2a {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

/* 搜索输入框容器 */
.search-input-wrapper.data-v-1cf27b2a {
  flex: 1;
  position: relative;
  background-color: #f5f5f5;
  border-radius: 35rpx;
  margin-right: 10rpx;
}

/* 搜索结果样式 */
.search-results.data-v-1cf27b2a {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}
.search-header.data-v-1cf27b2a {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1px solid #eee;
}
.search-title.data-v-1cf27b2a {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}
.close-btn.data-v-1cf27b2a {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.close-btn text.data-v-1cf27b2a {
  font-size: 48rpx;
  color: #999;
}
.search-loading.data-v-1cf27b2a {
  padding: 60rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}
.friend-item.data-v-1cf27b2a {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1px solid #f5f5f5;
}
.friend-item.data-v-1cf27b2a:last-child {
  border-bottom: none;
}
.friend-avatar.data-v-1cf27b2a {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}
.friend-info.data-v-1cf27b2a {
  flex: 1;
  overflow: hidden;
}
.friend-name.data-v-1cf27b2a {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.friend-signature.data-v-1cf27b2a {
  font-size: 26rpx;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.friend-arrow.data-v-1cf27b2a {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.arrow-icon.data-v-1cf27b2a {
  width: 36rpx;
  height: 36rpx;
  color: #999;
}
.no-results.data-v-1cf27b2a {
  padding: 80rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}
.search-input.data-v-1cf27b2a {
  width: 100%;
  height: 70rpx;
  font-size: 28rpx;
  padding: 0 20rpx 0 20rpx;
  background: transparent;
  border: none;
  outline: none;
}

/* 清空按钮 */
.clear-btn.data-v-1cf27b2a {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: #ccc;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  transition: all 0.2s;
}
.clear-btn.data-v-1cf27b2a:active {
  background-color: #999;
}
.search-btn.data-v-1cf27b2a {
  width: 120rpx;
  height: 50rpx;
  line-height: 50rpx;
  font-size: 28rpx;
  background-color: #007aff;
  color: #fff;
  border: none;
  border-radius: 25rpx;
  transition: background-color 0.2s;
}
.search-btn.data-v-1cf27b2a:active {
  background-color: #0056b3;
}

/* 轮播区域 */
.banner.data-v-1cf27b2a {
  width: 100%;
  height: 300rpx;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
  overflow: hidden;
}
.swiper.data-v-1cf27b2a {
  width: 100%;
  height: 100%;
}
.banner-item.data-v-1cf27b2a {
  width: 100%;
  height: 100%;
}
.banner-image.data-v-1cf27b2a {
  width: 100%;
  height: 100%;
}

/* 分类标签 */
.tab-bar.data-v-1cf27b2a {
      display: flex;
      background-color: #fff;
      border-radius: 16rpx;
      margin-top: 20rpx;
      margin-bottom: 20rpx;
      overflow: hidden;
}
.tab-item.data-v-1cf27b2a {
      flex: 1;
      height: 80rpx;
      line-height: 80rpx;
      text-align: center;
      font-size: 28rpx;
      position: relative;
      cursor: pointer;
}
.tab-item.active.data-v-1cf27b2a {
      color: #2699fb;
      font-weight: bold;
}
.tab-item.active.data-v-1cf27b2a::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 40rpx;
      height: 6rpx;
      background-color: #2699fb;
      border-radius: 3rpx;
}
    
    /* 内容容器（可滚动） */
.content-container.data-v-1cf27b2a {
  overflow-y: auto; /* 允许纵向滚动 */
