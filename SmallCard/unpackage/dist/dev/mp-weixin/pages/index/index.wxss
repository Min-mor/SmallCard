  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

/* 内容列表 */
.content-list.data-v-1cf27b2a {
  margin-bottom: 30rpx;
}
.content-item.data-v-1cf27b2a {
